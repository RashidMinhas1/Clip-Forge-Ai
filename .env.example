# ============================================================
# ClipForge AI — Environment Configuration Blueprint
# DO NOT ADD REAL SECRETS TO THIS FILE. USE FOR PLACEHOLDERS ONLY.
# ============================================================

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string
BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# Database Connection (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_db_password
POSTGRES_DB=clipforge_db
DATABASE_URL=postgresql+asyncpg://postgres:replace_with_db_password@localhost:5432/clipforge_db

# Redis & Task Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# AI Provider Credentials (Server-side handling only)
OPENAI_API_KEY=sk-placeholder-replace-with-real-key
GEMINI_API_KEY=placeholder-replace-with-real-key
OPENROUTER_API_KEY=placeholder-replace-with-real-key
DEFAULT_AI_PROVIDER=openai
DEFAULT_AI_MODEL=gpt-4o

# Storage Configuration (Local Development vs Production S3)
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage
S3_BUCKET_NAME=clipforge-media-bucket
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=placeholder_access_key
AWS_SECRET_ACCESS_KEY=placeholder_secret_key

# FFmpeg Executable Paths (If non-standard binary location)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
